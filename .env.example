# ============================================
# POLYMARKET CONFIGURATION
# ============================================

# Your private key (EOA or Magic wallet export)
# NEVER commit this to git - keep it in .env only
POLY_PRIVATE_KEY=0x...

# Your funder address (proxy wallet / smart contract wallet address)
POLY_FUNDER_ADDRESS=0x...

# Signature type: 0=EOA, 1=Email/Magic, 2=Browser/Proxy
POLY_SIGNATURE_TYPE=1

# Relayer API Key (from Polymarket Settings > API Keys)
# Used for gasless on-chain operations (approve, redeem, etc.)
RELAYER_API_KEY=your_relayer_api_key_here
RELAYER_API_KEY_ADDRESS=0x...

# CLOB API credentials (auto-derived from private key, but can be set manually)
# Run setup_creds.py once to generate these, then paste here
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ============================================
# TRADING CONFIGURATION
# ============================================

# Position sizing (USDC)
STRONG_BET_SIZE=1.0
MODERATE_BET_SIZE=0.5
MIN_BET_SIZE=1.0

# Strategy thresholds
VOLUME_YES_THRESHOLD=0.60
PRICE_CHANGE_THRESHOLD=0.03
SPREAD_MAX_THRESHOLD=0.02

# Entry timing: seconds before market close to enter (20-45s)
ENTRY_TIMING_SECONDS=30

# Scanning interval in seconds
SCAN_INTERVAL_SECONDS=5

# ============================================
# BINANCE CONFIG
# ============================================
BINANCE_SYMBOL=BTCUSDT
BINANCE_INTERVAL=1m
BINANCE_KLINE_LIMIT=50

# ============================================
# MISC
# ============================================
# Set to "true" to simulate trades without real money
DRY_RUN=false
LOG_LEVEL=INFO
